{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Andrologic/AgSDL/v0.5.0/schema/archive.schema.json",
  "title": "AgSDL archive inventory",
  "type": "object",
  "required": [
    "archiveFormat",
    "files"
  ],
  "properties": {
    "archiveFormat": {
      "const": "agsdl-archive-1"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "size",
          "sha256",
          "executable"
        ],
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "executable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "history": {
      "type": "object",
      "required": [
        "size",
        "sha256",
        "commit"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
