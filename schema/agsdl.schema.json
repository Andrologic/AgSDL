{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Andrologic/AgSDL/schema/agsdl.schema.json",
  "title": "AgSDL 0.3.0 document",
  "type": "object",
  "required": [
    "contract",
    "id",
    "agents"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract": {
      "const": "agsdl-0.3.0"
    },
    "id": {
      "$ref": "#/$defs/name"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "content": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "uri"
        ],
        "additionalProperties": false,
        "properties": {
          "uri": {
            "$ref": "#/$defs/uri"
          }
        }
      }
    },
    "mcpServers": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mcpServer"
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    },
    "flow": {
      "type": "object",
      "required": [
        "entry",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "entry": {
          "$ref": "#/$defs/name"
        },
        "steps": {
          "$ref": "#/$defs/steps"
        },
        "onError": {
          "$ref": "#/$defs/route"
        }
      }
    },
    "compositions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/composition"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "choice": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "not": {
        "enum": [
          "step",
          "output",
          "message"
        ]
      }
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z][A-Za-z0-9+.\\-]*:|(?![^/?#]*:))(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-Fa-f]{2})+$"
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
    },
    "text": {
      "type": "string"
    },
    "maxVisits": {
      "type": "integer",
      "minimum": 1
    },
    "path": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "integer",
            "minimum": 0
          }
        ]
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": true,
            "mediaType": {
              "$ref": "#/$defs/mediaType"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "uri"
          ],
          "additionalProperties": false,
          "properties": {
            "uri": {
              "$ref": "#/$defs/uri"
            },
            "mediaType": {
              "$ref": "#/$defs/mediaType"
            }
          }
        }
      ]
    },
    "contentUse": {
      "oneOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "object",
          "required": [
            "ref"
          ],
          "additionalProperties": false,
          "properties": {
            "ref": {
              "$ref": "#/$defs/name"
            }
          }
        }
      ]
    },
    "instructions": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentUse"
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/contentUse"
      }
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      },
      "uniqueItems": true
    },
    "mcpServer": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "command"
          ],
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "$ref": "#/$defs/uri"
            }
          }
        }
      ]
    },
    "agent": {
      "type": "object",
      "required": [
        "harness",
        "permissions"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "harness": {
          "$ref": "#/$defs/name"
        },
        "harnessVersion": {
          "type": "string",
          "minLength": 1
        },
        "harnessSettings": {
          "type": "object"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "instructions": {
          "$ref": "#/$defs/instructions"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "skills": {
          "$ref": "#/$defs/names"
        },
        "mcpServers": {
          "$ref": "#/$defs/names"
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "results": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/result"
          }
        },
        "instructs": {
          "type": "boolean"
        },
        "plan": {
          "type": "boolean"
        },
        "planFirst": {
          "enum": [
            "auto",
            "ask"
          ]
        },
        "completionCheck": {
          "type": "object",
          "required": [
            "command"
          ],
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "choices": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/choice"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "maxFailures": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "maxCorrections": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "permissions": {
      "oneOf": [
        {
          "$ref": "#/$defs/preset"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preset": {
              "$ref": "#/$defs/preset"
            },
            "directories": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "enum": [
                  "read",
                  "write"
                ]
              }
            },
            "outside": {
              "enum": [
                "read",
                "deny"
              ]
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/permissionRule"
              }
            },
            "reviewer": {
              "enum": [
                "person",
                "model"
              ]
            }
          }
        }
      ]
    },
    "preset": {
      "enum": [
        "read-only",
        "workspace",
        "full"
      ]
    },
    "permissionRule": {
      "type": "object",
      "required": [
        "action",
        "effect"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "match"
        ],
        "properties": {
          "action": {
            "const": "delegate"
          }
        }
      },
      "properties": {
        "action": {
          "enum": [
            "read",
            "write",
            "shell",
            "network",
            "mcp",
            "delegate"
          ]
        },
        "match": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "mediaType": {
          "$ref": "#/$defs/mediaType"
        },
        "description": {
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/valueSchema"
        }
      }
    },
    "valueSchema": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "null",
            "boolean",
            "number",
            "integer",
            "string",
            "array",
            "object"
          ]
        },
        "description": {
          "type": "string"
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "items": {
          "$ref": "#/$defs/valueSchema"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/valueSchema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "type": "boolean"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "oneOf": [
            {
              "$ref": "#/$defs/instructions"
            },
            {
              "type": "object",
              "required": [
                "from"
              ],
              "additionalProperties": false,
              "properties": {
                "from": {
                  "$ref": "#/$defs/path"
                }
              }
            }
          ]
        },
        "resources": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/contentUse"
              },
              {
                "type": "object",
                "required": [
                  "from"
                ],
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "$ref": "#/$defs/path"
                  },
                  "mediaType": {
                    "$ref": "#/$defs/mediaType"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "type": "object",
          "required": [
            "step"
          ],
          "additionalProperties": false,
          "properties": {
            "step": {
              "$ref": "#/$defs/name"
            },
            "each": {
              "$ref": "#/$defs/path"
            },
            "message": {
              "$ref": "#/$defs/message"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "output"
          ],
          "additionalProperties": false,
          "properties": {
            "output": {
              "$ref": "#/$defs/name"
            },
            "message": {
              "$ref": "#/$defs/message"
            }
          }
        }
      ]
    },
    "route": {
      "oneOf": [
        {
          "$ref": "#/$defs/target"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      ]
    },
    "routeMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/choice"
      },
      "additionalProperties": {
        "$ref": "#/$defs/route"
      }
    },
    "operand": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": true
          }
        },
        {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            }
          }
        }
      ]
    },
    "steps": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/step"
      }
    },
    "step": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "agent",
            "call",
            "approval",
            "compose",
            "join"
          ]
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/agentStep"
        },
        {
          "$ref": "#/$defs/callStep"
        },
        {
          "$ref": "#/$defs/approvalStep"
        },
        {
          "$ref": "#/$defs/composeStep"
        },
        {
          "$ref": "#/$defs/joinStep"
        }
      ]
    },
    "agentStep": {
      "type": "object",
      "required": [
        "type",
        "agent"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "agent"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "maxVisits": {
          "$ref": "#/$defs/maxVisits"
        },
        "agent": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "object",
              "required": [
                "parameter"
              ],
              "additionalProperties": false,
              "properties": {
                "parameter": {
                  "$ref": "#/$defs/name"
                }
              }
            }
          ]
        },
        "instance": {
          "$ref": "#/$defs/name"
        },
        "delivery": {
          "enum": [
            "queue",
            "steer"
          ]
        },
        "prompt": {
          "$ref": "#/$defs/instructions"
        },
        "next": {
          "oneOf": [
            {
              "$ref": "#/$defs/route"
            },
            {
              "$ref": "#/$defs/routeMap"
            }
          ]
        },
        "onError": {
          "$ref": "#/$defs/route"
        }
      }
    },
    "callStep": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "call"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "maxVisits": {
          "$ref": "#/$defs/maxVisits"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "mcp": {
          "type": "object",
          "required": [
            "server",
            "tool"
          ],
          "additionalProperties": false,
          "properties": {
            "server": {
              "$ref": "#/$defs/name"
            },
            "tool": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/operand"
          }
        },
        "next": {
          "oneOf": [
            {
              "$ref": "#/$defs/route"
            },
            {
              "$ref": "#/$defs/routeMap"
            }
          ]
        },
        "onError": {
          "$ref": "#/$defs/route"
        }
      },
      "oneOf": [
        {
          "required": [
            "command"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "mcp"
                ]
              },
              {
                "required": [
                  "arguments"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "mcp"
          ],
          "not": {
            "required": [
              "command"
            ]
          }
        }
      ]
    },
    "approvalStep": {
      "type": "object",
      "required": [
        "type",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "approval"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "maxVisits": {
          "$ref": "#/$defs/maxVisits"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "next": {
          "$ref": "#/$defs/routeMap"
        },
        "onError": {
          "$ref": "#/$defs/route"
        }
      }
    },
    "composeStep": {
      "type": "object",
      "required": [
        "type",
        "composition",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "compose"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "maxVisits": {
          "$ref": "#/$defs/maxVisits"
        },
        "composition": {
          "$ref": "#/$defs/name"
        },
        "agents": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/name"
              },
              {
                "type": "object",
                "required": [
                  "parameter"
                ],
                "additionalProperties": false,
                "properties": {
                  "parameter": {
                    "$ref": "#/$defs/name"
                  }
                }
              }
            ]
          }
        },
        "next": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/route"
          }
        },
        "onError": {
          "$ref": "#/$defs/route"
        }
      }
    },
    "joinStep": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "join"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "maxVisits": {
          "$ref": "#/$defs/maxVisits"
        },
        "quorum": {
          "type": "object",
          "required": [
            "count",
            "accept"
          ],
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "accept": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/choice"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "remaining": {
          "enum": [
            "stop",
            "finish",
            "wait"
          ]
        },
        "failures": {
          "enum": [
            "fail",
            "keep"
          ]
        },
        "maxFailures": {
          "type": "integer",
          "minimum": 1
        },
        "next": {
          "oneOf": [
            {
              "$ref": "#/$defs/route"
            },
            {
              "$ref": "#/$defs/routeMap"
            }
          ]
        },
        "onError": {
          "$ref": "#/$defs/route"
        }
      }
    },
    "composition": {
      "type": "object",
      "required": [
        "entry",
        "steps",
        "outputs"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/names"
        },
        "entry": {
          "$ref": "#/$defs/name"
        },
        "steps": {
          "$ref": "#/$defs/steps"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
