{
  "contract": "agsdl-0.3.0",
  "id": "release-approval",
  "title": "Release notes with approval",
  "mcpServers": {
    "releases": {
      "command": [
        "node",
        "tools/releases-server.js"
      ]
    }
  },
  "agents": {
    "writer": {
      "harness": "codex",
      "model": {
        "name": "example/large"
      },
      "instructions": "Write the release notes from the merged changes, for users, in plain language.",
      "permissions": "workspace",
      "results": {
        "notes": {
          "required": true,
          "mediaType": "text/markdown"
        }
      }
    }
  },
  "flow": {
    "entry": "write",
    "steps": {
      "write": {
        "type": "agent",
        "agent": "writer",
        "maxVisits": 3,
        "next": {
          "step": "approve",
          "message": {
            "prompt": "Approve these release notes for publication.",
            "resources": {
              "notes": {
                "from": [
                  "results",
                  "notes"
                ]
              }
            }
          }
        }
      },
      "approve": {
        "type": "approval",
        "title": "Publish the release?",
        "timeoutMs": 86400000,
        "next": {
          "publish": "publish",
          "revise": {
            "step": "write",
            "message": {
              "prompt": "The release was not approved. Revise the notes.",
              "resources": {
                "comment": {
                  "from": [
                    "comment"
                  ]
                }
              }
            }
          }
        }
      },
      "publish": {
        "type": "call",
        "mcp": {
          "server": "releases",
          "tool": "publish"
        },
        "arguments": {
          "channel": {
            "value": "stable"
          }
        }
      }
    }
  }
}
