{
  "contract": "agsdl-0.3.0",
  "id": "assistant",
  "title": "A configured coding assistant",
  "description": "No flow: a host runs this agent and sends it messages directly.",
  "skills": {
    "security-review": {
      "uri": "skills/security-review/SKILL.md"
    }
  },
  "mcpServers": {
    "github": {
      "url": "https://mcp.example.com/github"
    }
  },
  "agents": {
    "assistant": {
      "harness": "claude-code",
      "description": "Implements changes in this repository.",
      "model": {
        "name": "example/large",
        "effort": "high"
      },
      "instructions": "Understand the request, implement it, then run the tests. Report what you changed.",
      "skills": [
        "security-review"
      ],
      "mcpServers": [
        "github"
      ],
      "permissions": {
        "preset": "workspace",
        "directories": {
          "~/notes": "read"
        },
        "rules": [
          {
            "action": "shell",
            "match": "git push *",
            "effect": "ask"
          },
          {
            "action": "write",
            "match": ".env*",
            "effect": "deny"
          },
          {
            "action": "mcp",
            "match": "github/create_pull_request",
            "effect": "ask"
          }
        ]
      },
      "plan": true,
      "planFirst": "auto",
      "completionCheck": {
        "command": "npm test"
      },
      "results": {
        "summary": {
          "required": true,
          "mediaType": "text/plain"
        }
      }
    }
  }
}
