{
  "contract": "agsdl-0.3.0",
  "id": "reusable-review",
  "title": "Reusable triple review",
  "description": "A writer's document goes through a reusable composition of three fresh reviews; two approvals pass it, otherwise the reviews go back to the writer.",
  "agents": {
    "writer": {
      "harness": "claude-code",
      "instructions": "Write the requested document, then revise it from reviews.",
      "permissions": "workspace"
    },
    "editor": {
      "harness": "opencode",
      "instructions": "Review the document. Choose approve or reject.",
      "permissions": "read-only"
    }
  },
  "compositions": {
    "triple-review": {
      "description": "Three fresh reviews; two approvals pass.",
      "parameters": [
        "reviewer"
      ],
      "entry": "spread",
      "steps": {
        "spread": {
          "type": "agent",
          "agent": {
            "parameter": "reviewer"
          },
          "instance": "coordinator",
        "prompt": "Read the document and describe it for the reviewers. Leave the review to them.",
          "next": [
            "first",
            "second",
            "third"
          ]
        },
        "first": {
          "type": "agent",
          "agent": {
            "parameter": "reviewer"
          },
          "instance": "new",
          "next": {
            "approve": "vote",
            "reject": "vote"
          }
        },
        "second": {
          "type": "agent",
          "agent": {
            "parameter": "reviewer"
          },
          "instance": "new",
          "next": {
            "approve": "vote",
            "reject": "vote"
          }
        },
        "third": {
          "type": "agent",
          "agent": {
            "parameter": "reviewer"
          },
          "instance": "new",
          "next": {
            "approve": "vote",
            "reject": "vote"
          }
        },
        "vote": {
          "type": "join",
          "quorum": {
            "count": 2,
            "accept": [
              "approve"
            ]
          },
          "next": {
            "reached": {
              "output": "approved"
            },
            "missed": {
              "output": "rejected"
            }
          }
        }
      },
      "outputs": [
        "approved",
        "rejected"
      ]
    }
  },
  "flow": {
    "entry": "write",
    "steps": {
      "write": {
        "type": "agent",
        "agent": "writer",
        "maxVisits": 4,
        "next": "review"
      },
      "review": {
        "type": "compose",
        "composition": "triple-review",
        "agents": {
          "reviewer": "editor"
        },
        "next": {
          "approved": [],
          "rejected": {
            "step": "write",
            "message": {
              "prompt": "The reviewers rejected the document. Revise it.",
              "resources": {
                "reviews": {
                  "from": [
                    "branches"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
