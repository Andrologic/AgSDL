{
  "contract": "agsdl-0.3.0",
  "id": "write-and-review",
  "title": "Write and review",
  "agents": {
    "developer": {
      "harness": "codex",
      "instructions": "Implement the request, then run the tests.",
      "permissions": "workspace",
      "completionCheck": {
        "command": "npm test"
      }
    },
    "reviewer": {
      "harness": "claude-code",
      "instructions": "Review the change. Choose ready or revise.",
      "permissions": "read-only"
    }
  },
  "flow": {
    "entry": "develop",
    "steps": {
      "develop": {
        "type": "agent",
        "agent": "developer",
        "next": "review"
      },
      "review": {
        "type": "agent",
        "agent": "reviewer",
        "instance": "new",
        "next": {
          "revise": "develop",
          "ready": []
        }
      }
    }
  }
}
