{
  "contract": "agsdl-0.3.0",
  "id": "fix-each-file",
  "title": "Fix each file",
  "description": "A lead lists the files to fix; one fresh worker per file, four at a time; failed files go back to the lead, and the tests run once every file is fixed.",
  "agents": {
    "lead": {
      "harness": "codex",
      "description": "Finds what to fix, file by file.",
      "model": {
        "name": "example/large",
        "effort": "high"
      },
      "instructions": "Run the linter and the tests, and list each file that needs a fix with its problem. Choose split when there is something to fix, clean otherwise.",
      "permissions": {
        "preset": "read-only",
        "rules": [
          {
            "action": "shell",
            "match": "npm run lint *",
            "effect": "allow"
          },
          {
            "action": "shell",
            "match": "npm test *",
            "effect": "allow"
          }
        ]
      },
      "results": {
        "files": {
          "required": true,
          "description": "The files to fix.",
          "schema": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "problem": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "problem"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    },
    "worker": {
      "harness": "claude-code",
      "description": "Fixes one file.",
      "model": {
        "name": "sonnet"
      },
      "instructions": "Fix the problem described in the message. Change only the file you are given.",
      "permissions": {
        "preset": "workspace",
        "reviewer": "person",
        "rules": [
          {
            "action": "shell",
            "match": "npm install *",
            "effect": "ask"
          }
        ]
      },
      "answerTimeoutMs": 1800000
    },
    "reporter": {
      "harness": "codex",
      "instructions": "Explain what failed and what a person should look at.",
      "permissions": "read-only"
    }
  },
  "flow": {
    "entry": "triage",
    "onError": "report",
    "steps": {
      "triage": {
        "type": "agent",
        "agent": "lead",
        "maxVisits": 4,
        "next": {
          "split": {
            "step": "fix",
            "each": [
              "results",
              "files"
            ],
            "concurrency": 4,
            "max": 20,
            "message": {
              "prompt": "Fix this problem.",
              "resources": {
                "file": {
                  "from": [
                    "item",
                    "path"
                  ]
                },
                "problem": {
                  "from": [
                    "item",
                    "problem"
                  ]
                }
              }
            }
          },
          "clean": []
        }
      },
      "fix": {
        "type": "agent",
        "agent": "worker",
        "instance": "new",
        "timeoutMs": 900000,
        "next": "gather"
      },
      "gather": {
        "type": "join",
        "failures": "keep",
        "maxFailures": 5,
        "next": {
          "done": "tests",
          "incomplete": {
            "step": "triage",
            "message": {
              "prompt": "Some fixes failed. List again the files that still need one.",
              "resources": {
                "fixes": {
                  "from": [
                    "branches",
                    "fix"
                  ]
                }
              }
            }
          }
        }
      },
      "tests": {
        "type": "call",
        "command": "npm test",
        "timeoutMs": 600000,
        "next": {
          "passed": [],
          "failed": {
            "step": "triage",
            "message": {
              "prompt": "The tests fail after the fixes. List the files that still need one.",
              "resources": {
                "output": {
                  "from": [
                    "data",
                    "output"
                  ]
                }
              }
            }
          }
        }
      },
      "report": {
        "type": "agent",
        "agent": "reporter",
        "prompt": "The flow failed. Report the error below."
      }
    }
  }
}
