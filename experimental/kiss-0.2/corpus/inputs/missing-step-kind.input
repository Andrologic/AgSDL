{
  "edition": "agsdl-exp-0017-c1",
  "agents": {
    "writer": {
      "instructions": [
        {
          "id": "task",
          "content": {
            "ref": "draft"
          }
        }
      ],
      "interface": {
        "ref": "text"
      }
    },
    "reviewer": {
      "instructions": [
        {
          "id": "task",
          "content": {
            "value": {
              "target": "Agent",
              "at": "before-invoke",
              "format": {
                "identity": "example/plain-text",
                "version": "1"
              },
              "body": "Correct unsupported claims in the draft."
            }
          }
        }
      ],
      "interface": {
        "ref": "text"
      }
    }
  },
  "instructions": {
    "draft": {
      "target": "Agent",
      "at": "before-invoke",
      "format": {
        "identity": "example/plain-text",
        "version": "1"
      },
      "body": "Rewrite the input concisely without adding facts."
    }
  },
  "interfaces": {
    "text": {
      "operations": {
        "rewrite": {
          "direction": "inbound",
          "mode": "request-response",
          "inputs": {
            "text": "string"
          },
          "outputs": {
            "text": "string"
          },
          "effects": "none"
        }
      }
    }
  },
  "graphs": {
    "pipeline": {
      "entry": "draft-call",
      "inputs": {
        "text": "string"
      },
      "outputs": {
        "text": "string"
      },
      "steps": [
        {
          "id": "draft-call",
          "agent": {
            "ref": "writer"
          },
          "operation": "rewrite",
          "bindings": {
            "text": {
              "input": "text"
            }
          },
          "success": "review-call",
          "failure": "failed"
        },
        {
          "id": "review-call",
          "kind": "invoke",
          "agent": {
            "ref": "reviewer"
          },
          "operation": "rewrite",
          "bindings": {
            "text": {
              "step": "draft-call",
              "port": "text"
            }
          },
          "success": "done",
          "failure": "failed"
        },
        {
          "id": "done",
          "kind": "end",
          "outcome": "success",
          "bindings": {
            "text": {
              "step": "review-call",
              "port": "text"
            }
          }
        },
        {
          "id": "failed",
          "kind": "end",
          "outcome": "failure",
          "reason": "Call failed"
        }
      ]
    }
  }
}
