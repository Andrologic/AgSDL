      "steps": [
        {
          "id": "draft-call",
          "kind": "invoke",
          "agent": {
            "ref": "writer"
          },
          "operation": "rewrite",
          "bindings": {
            "text": {
              "input": "text"
            }
          },
          "success": "review-call",
          "failure": "failed"
        },
        {
          "id": "review-call",
          "kind": "invoke",
          "agent": {
            "ref": "reviewer"
          },
          "operation": "rewrite",
          "bindings": {
            "text": {
              "step": "draft-call",
              "port": "text"
            }
          },
          "success": "done",
          "failure": "failed"
        },
        {
          "id": "done",
          "kind": "end",
          "outcome": "success",
          "bindings": {
            "text": {
              "step": "review-call",
              "port": "text"
            }
          }
        },
        {
          "id": "failed",
          "kind": "end",
          "outcome": "failure",
          "reason": "Call failed"
        }
      ]
    }
  },
