  "instructions": {
    "draft": {
      "target": "Agent",
      "at": "before-invoke",
      "format": {
        "identity": "example/plain-text",
        "version": "1"
      },
      "body": "Rewrite the input concisely without adding facts."
    }
  },
  "interfaces": {
    "text": {
      "operations": {
        "rewrite": {
          "direction": "inbound",
          "mode": "request-response",
          "inputs": {
