          "inputs": {
            "text": "string"
          },
          "outputs": {
            "text": "string"
          },
          "effects": "none"
        }
      }
    }
  },
  "extensions": [
    {
      "edition": {
        "identity": "private/required-semantics",
        "version": "1"
      },
