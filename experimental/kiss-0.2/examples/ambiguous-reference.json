  },
  "interfaces": {
    "text": {
      "operations": {
        "rewrite": {
          "direction": "inbound",
          "mode": "request-response",
          "inputs": {
            "text": "string"
          },
          "outputs": {
            "text": "string"
          },
          "effects": "none"
        }
      }
    }
  },
  "principals": {
    "draft": {
      "description": "Conflicting local id"
    }
  }
}
