      "type": "object",
      "properties": {
        "configurations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Configuration"
          }
        },
        "selected": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "configurations"
      ],
      "additionalProperties": false
    },
    "Configuration": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Text"
