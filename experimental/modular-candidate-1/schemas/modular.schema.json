      "type": "object",
      "properties": {
        "target": {
          "const": "Agent"
        },
        "at": {
          "const": "before-invoke"
        },
        "format": {
          "$ref": "#/$defs/Edition"
        },
        "body": {
          "$ref": "#/$defs/Text"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edition"
          }
        }
      },
      "required": [
        "target",
        "at",
        "format",
        "body",
        "requires"
      ],
      "additionalProperties": false
    },
    "SkillPayload": {
      "type": "object",
      "properties": {
        "inputs": {
          "$ref": "#/$defs/Ports"
        },
        "outputs": {
          "$ref": "#/$defs/Ports"
        },
        "preconditions": {
          "$ref": "#/$defs/Text"
        },
        "completion": {
          "$ref": "#/$defs/Text"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          }
