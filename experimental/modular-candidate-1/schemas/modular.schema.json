        "parameters": true,
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edition"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityClaim"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolBinding"
          }
        },
        "applications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Application"
          }
        }
