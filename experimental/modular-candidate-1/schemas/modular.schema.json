        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edition"
          }
        }
      },
      "required": [
        "inputs",
        "outputs",
        "preconditions",
        "completion",
        "dependencies",
        "tools",
        "requires"
      ],
      "additionalProperties": false
    }
