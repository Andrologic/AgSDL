      "required": [
        "id",
        "kind",
        "agent",
        "interface",
        "action",
        "principal",
        "resources",
        "context",
        "inputs",
        "outputs",
        "bindings",
        "success",
        "failure",
        "operation"
      ],
      "additionalProperties": false
    },
    "ApprovalStep": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Text"
        },
        "kind": {
          "const": "approval"
        },
        "requirement": {
          "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Ref"
        },
        "timeoutMs": {
          "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Positive"
        },
        "approved": {
          "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Text"
        },
        "denied": {
          "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Text"
        },
        "failure": {
          "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Text"
        },
        "call": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "kind",
        "requirement",
        "timeoutMs",
        "approved",
        "denied",
        "failure",
        "call"
      ],
      "additionalProperties": false
    },
    "Step": {
      "oneOf": [
        {
          "$ref": "#/$defs/InvokeStep"
        },
        {
          "$ref": "#/$defs/ApprovalStep"
        },
        {
          "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/ConditionStep"
        },
        {
          "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/SuccessEndStep"
        },
        {
          "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/OtherEndStep"
        }
      ]
