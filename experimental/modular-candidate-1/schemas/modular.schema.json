{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal 0013 modular candidate-1 shapes",
  "$comment": "Experimental shapes derived from proposal 0013; no semantic verdict, runtime support or normative adoption. Entry point is D Document; select Graphs, RuntimeDeclaration or payload definitions explicitly for other scopes.",
  "$ref": "#/$defs/Document",
  "$defs": {
    "Text": {
      "$ref": "../../candidate-2/schemas/D.schema.json#/$defs/Text"
    },
    "Key": {
      "$ref": "../../candidate-2/schemas/D.schema.json#/$defs/Key"
    },
    "Edition": {
      "$ref": "../../candidate-2/schemas/D.schema.json#/$defs/Edition"
    },
    "Hash": {
      "$ref": "../../candidate-2/schemas/D.schema.json#/$defs/Hash"
    },
    "Ref": {
      "$ref": "../../candidate-2/schemas/D.schema.json#/$defs/Ref"
    },
    "Ports": {
      "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Ports"
    },
    "Bindings": {
      "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Bindings"
    },
    "Binding": {
      "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Binding"
    },
    "Positive": {
      "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Positive"
    },
    "ApprovalRequirementPayload": {
      "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/ApprovalRequirementPayload"
    },
    "Document": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "proposal-0013-candidate-1"
        },
        "root": {
          "$ref": "../../candidate-2/schemas/D.schema.json#/$defs/Root"
        },
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "../../candidate-2/schemas/D.schema.json#/$defs/Definition"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "../../candidate-2/schemas/D.schema.json#/$defs/Relation"
          }
        },
        "exports": {
          "type": "array",
          "items": {
            "$ref": "../../candidate-2/schemas/D.schema.json#/$defs/Key"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "../../candidate-2/schemas/D.schema.json#/$defs/Dependency"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "../../candidate-2/schemas/D.schema.json#/$defs/Deferral"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "../../candidate-2/schemas/D.schema.json#/$defs/Extension"
          }
        },
        "annotations": true,
        "evidence": true,
        "graphs": true,
        "runtime": true
      },
      "required": [
        "contract",
        "root",
        "definitions",
        "relations",
        "exports",
        "dependencies",
        "unresolved",
        "extensions"
      ],
      "additionalProperties": false
    },
    "InvokeStep": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Text"
        },
        "kind": {
          "const": "invoke"
        },
        "agent": {
          "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Ref"
        },
        "interface": {
          "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Ref"
        },
        "action": {
          "$ref": "../../candidate-2/schemas/G.schema.json#/$defs/Ref"
