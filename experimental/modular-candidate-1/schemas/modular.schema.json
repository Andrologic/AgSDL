        "inputs": {
          "$ref": "#/$defs/Ports"
        },
        "outputs": {
          "$ref": "#/$defs/Ports"
        },
        "effects": {
          "enum": [
            "none",
            "external",
            "unknown"
          ]
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edition"
          }
        }
      },
      "required": [
        "action",
        "inputs",
        "outputs",
        "effects",
        "failures",
        "requires"
      ],
      "additionalProperties": false
