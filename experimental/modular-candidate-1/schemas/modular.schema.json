      },
      "required": [
        "content",
        "adapter",
        "parameters"
      ],
      "additionalProperties": false
    },
    "CapabilityClaim": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/Edition"
        },
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/Hash"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "capability",
        "status",
        "evidence"
      ],
      "additionalProperties": false
