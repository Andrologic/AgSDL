{
  "contract": "agsdl-0.4.0",
  "id": "review-project",
  "agents": {
    "reviewer": {
      "harness": "codex",
      "permissions": "read-only",
      "instructions": [{ "uri": "agents/reviewer/instructions.md" }],
      "mcpServers": ["issues"],
      "harnessSettings": { "webSearch": "disabled" }
    }
