{
  "contract": "agsdl-0.3.0",
  "id": "fanout-options-without-each",
  "agents": {
    "lead": {
      "harness": "example",
      "permissions": "read-only",
      "results": {
        "files": {
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "summary": {
          "mediaType": "text/plain"
        }
      }
    },
    "worker": {
      "harness": "example",
      "permissions": "workspace"
    }
  },
  "flow": {
    "entry": "plan",
    "steps": {
      "plan": {
        "type": "agent",
        "agent": "lead",
        "maxVisits": 3,
        "next": {
          "split": {
            "step": "fix",
            "concurrency": 2,
            "max": 10
          },
          "none": "fix"
        }
      },
      "fix": {
        "type": "agent",
        "agent": "worker",
        "instance": "new",
        "next": "summary"
      },
      "summary": {
        "type": "agent",
        "agent": "lead"
      }
    }
  }
}
