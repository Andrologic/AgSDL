{
  "contract": "agsdl-0.3.0",
  "id": "instructions-not-instructing",
  "agents": {
    "triage": {
      "harness": "example",
      "permissions": "read-only"
    },
    "architect": {
      "harness": "example",
      "permissions": "read-only",
      "instructs": true,
      "results": {
        "plan": {
          "mediaType": "text/markdown"
        }
      }
    },
    "reviewer": {
      "harness": "example",
      "permissions": "read-only"
    },
    "builder": {
      "harness": "example",
      "permissions": "workspace"
    }
  },
  "flow": {
    "entry": "triage",
    "steps": {
      "triage": {
        "type": "agent",
        "agent": "triage",
        "next": {
          "design": "design",
          "review": "review"
        }
      },
      "design": {
        "type": "agent",
        "agent": "architect",
        "next": "build"
      },
      "review": {
        "type": "agent",
        "agent": "reviewer",
        "next": {
          "step": "build",
          "message": {
            "prompt": {
              "from": [
                "instructions"
              ]
            }
          }
        }
      },
      "build": {
        "type": "agent",
        "agent": "builder",
        "prompt": "Implement the requested change."
      }
    }
  }
}
