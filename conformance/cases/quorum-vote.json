{
  "contract": "agsdl-0.3.0",
  "id": "quorum-vote",
  "agents": {
    "lead": {
      "harness": "example",
      "permissions": "read-only"
    },
    "voter": {
      "harness": "example",
      "permissions": "read-only"
    }
  },
  "flow": {
    "entry": "propose",
    "steps": {
      "propose": {
        "type": "agent",
        "agent": "lead",
        "next": [
          "v1",
          "v2",
          "v3"
        ]
      },
      "v1": {
        "type": "agent",
        "agent": "voter",
        "instance": "new",
        "next": {
          "approve": "vote",
          "reject": "vote"
        }
      },
      "v2": {
        "type": "agent",
        "agent": "voter",
        "instance": "new",
        "next": {
          "approve": "vote",
          "reject": "vote"
        }
      },
      "v3": {
        "type": "agent",
        "agent": "voter",
        "instance": "new",
        "next": {
          "approve": "vote",
          "reject": "vote"
        }
      },
      "vote": {
        "type": "join",
        "quorum": {
          "count": 2,
          "accept": [
            "approve"
          ]
        },
        "remaining": "stop",
        "next": {
          "reached": "publish",
          "missed": "propose"
        }
      },
      "publish": {
        "type": "call",
        "command": "make publish"
      }
    }
  }
}
