  "timeline": [
    {
      "work": "origin",
      "returns": {
        "text": "",
        "results": {}
      }
    },
    {
      "running": [
        {
          "step": "a"
        }
      ]
    },
    {
      "work": "a",
      "returns": {
        "text": "",
        "results": {},
        "choice": "one"
      }
    }
