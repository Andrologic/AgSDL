          "type": "agent",
          "agent": "worker",
          "next": [
            "a",
            "b"
          ]
        },
        "a": {
          "type": "agent",
          "agent": "worker",
          "next": {
            "one": "j1",
            "two": "j2"
          },
          "delivery": "queue"
        },
        "b": {
          "type": "agent",
          "agent": "worker",
          "next": {
