{
  "description": "A quorum join continues once enough branches are accepted, with the accepted results only; remaining stop cancels the rest.",
  "document": {
    "contract": "agsdl-0.3.0",
    "id": "quorum-reached",
    "agents": {
      "lead": {
        "harness": "example",
        "permissions": "workspace"
      },
      "reviewer": {
        "harness": "example",
        "permissions": "read-only"
      }
    },
    "flow": {
      "entry": "spread",
      "steps": {
        "spread": {
          "type": "agent",
          "agent": "lead",
          "next": [
            "r1",
            "r2",
            "r3"
          ]
        },
        "r1": {
          "type": "agent",
          "agent": "reviewer",
          "instance": "new",
          "next": {
            "approve": "vote",
            "reject": "vote"
          }
        },
        "r2": {
          "type": "agent",
          "agent": "reviewer",
          "instance": "new",
          "next": {
            "approve": "vote",
            "reject": "vote"
          }
        },
        "r3": {
          "type": "agent",
          "agent": "reviewer",
          "instance": "new",
          "next": {
            "approve": "vote",
            "reject": "vote"
          }
        },
        "vote": {
          "type": "join",
          "quorum": {
            "count": 2,
            "accept": [
              "approve"
            ]
          },
          "remaining": "stop",
          "next": {
            "reached": "publish",
            "missed": "revise"
          }
        },
        "publish": {
          "type": "call",
          "command": "make publish"
        },
        "revise": {
          "type": "agent",
          "agent": "lead",
          "prompt": "Revise."
        }
      }
    }
  },
  "entry": {
    "prompt": "Start."
  },
  "timeline": [
    {
      "work": "spread",
      "returns": {
        "text": "Vote."
      }
    },
    {
      "work": "r1",
      "returns": {
        "text": "Yes.",
        "choice": "approve"
      }
    },
    {
      "work": "r3",
      "returns": {
        "text": "No.",
        "choice": "reject"
      }
    },
    {
      "work": "r2",
      "returns": {
        "text": "Yes too.",
        "choice": "approve"
      }
    },
    {
      "work": "publish",
      "command": {
        "exitCode": 0
      }
    }
  ],
  "expect": {
    "run": "succeeded",
    "starts": {
      "spread": 1,
      "r1": 1,
      "r2": 1,
      "r3": 1,
      "publish": 1
    },
    "joins": [
      {
        "join": "vote",
        "outcome": "reached",
        "branches": {
          "r1": {
            "choice": "approve"
          },
          "r2": {
            "choice": "approve"
          }
        }
      }
    ],
    "cancelled": [],
    "failures": []
  }
}
