{
  "description": "timeoutMs counts machine time only: the clock stands still while a person is asked, and the step fails with TIMEOUT once machine time runs out.",
  "document": {
    "contract": "agsdl-0.3.0",
    "id": "timeout-pauses-for-person",
    "agents": {
      "dev": {
        "harness": "example",
        "permissions": {
          "preset": "workspace",
          "reviewer": "person",
          "rules": [
            {
              "action": "shell",
              "match": "npm publish *",
              "effect": "ask"
            }
          ]
        }
      },
      "ops": {
        "harness": "example",
        "permissions": "read-only"
      }
    },
    "flow": {
      "entry": "release",
      "steps": {
        "release": {
          "type": "agent",
          "agent": "dev",
          "timeoutMs": 60000,
          "next": [],
          "onError": "report"
        },
        "report": {
          "type": "agent",
          "agent": "ops",
          "prompt": "Report the failure."
        }
      }
    }
  },
  "entry": {
    "prompt": "Start."
  },
  "timeline": [
    {
      "elapse": 30000
    },
    {
      "work": "release",
      "request": "ask"
    },
    {
      "elapse": 3600000
    },
    {
      "running": [
        {
          "step": "release"
        }
      ]
    },
    {
      "work": "release",
      "answer": "yes"
    },
    {
      "elapse": 40000
    },
    {
      "running": [
        {
          "step": "report"
        }
      ]
    },
    {
      "work": "report",
      "returns": {
        "text": "Release timed out."
      }
    }
  ],
  "expect": {
    "run": "succeeded",
    "starts": {
      "release": 1,
      "report": 1
    },
    "messages": [
      {
        "to": "report",
        "resources": {
          "error": {
            "code": "TIMEOUT"
          }
        }
      }
    ],
    "failures": [
      {
        "step": "release",
        "code": "TIMEOUT"
      }
    ]
  }
}
